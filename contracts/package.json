{
  "name": "brixup-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "BrixUp smart contracts — $BRXU token, deal escrow, staking",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:gas": "REPORT_GAS=true npx hardhat test",
    "deploy:testnet": "npx hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:mainnet": "npx hardhat run scripts/deploy.ts --network base",
    "deploy:brxu:testnet": "npx hardhat run scripts/deploy-brxu.ts --network baseSepolia",
    "deploy:brxu:mainnet": "npx hardhat run scripts/deploy-brxu.ts --network base",
    "verify": "npx hardhat run scripts/verify-contracts.ts --network base",
    "verify:testnet": "npx hardhat run scripts/verify-contracts.ts --network baseSepolia",
    "verify:brxu": "npx hardhat run scripts/verify-brxu.ts --network base",
    "setup:liquidity": "npx hardhat run scripts/setup-liquidity.ts --network base",
    "setup:wallet": "npx tsx scripts/setup-wallet.ts",
    "sync:env": "npx tsx scripts/sync-env.ts",
    "sync:env:testnet": "npx tsx scripts/sync-env.ts baseSepolia",
    "go:mainnet": "npm run deploy:mainnet && npm run sync:env"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.44.1",
    "dotenv": "^17.3.1"
  }
}
