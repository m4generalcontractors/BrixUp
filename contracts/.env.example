# ============================================================================
# BrixUp Smart Contracts — Environment Variables
# ============================================================================
# Copy this file to .env and fill in real values before deploying.
#   cp .env.example .env
# ============================================================================

# Private key of the deployer wallet (without 0x prefix).
# WARNING: Never commit your actual private key to source control.
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Base Sepolia testnet RPC endpoint.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base mainnet RPC endpoint.
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Basescan API key for contract verification.
# Obtain one at https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here
