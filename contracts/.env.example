# =============================================================================
# BrixUp Smart Contracts — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before deploying.
#   cp .env.example .env
# WARNING: Never commit your actual .env file to source control.
# =============================================================================

# ---------------------------------------------------------------------------
#  Network RPC URLs
# ---------------------------------------------------------------------------

# Base Sepolia testnet RPC endpoint
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base mainnet RPC endpoint
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# ---------------------------------------------------------------------------
#  Coinbase Developer Platform (CDP) — Wallet Management
# ---------------------------------------------------------------------------

# CDP API credentials (from https://portal.cdp.coinbase.com)
# Used by scripts/setup-wallet.ts to create and manage platform wallets.
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret
CDP_WALLET_SECRET=your_cdp_wallet_secret

# ---------------------------------------------------------------------------
#  Deployer Wallet
# ---------------------------------------------------------------------------

# Private key of the deployer wallet (without 0x prefix).
# Auto-populated by `npm run setup:wallet` if using CDP, or set manually.
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ---------------------------------------------------------------------------
#  Block Explorer Verification
# ---------------------------------------------------------------------------

# Basescan API key for contract source-code verification.
# Obtain one at https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key

# ---------------------------------------------------------------------------
#  Token Configuration
# ---------------------------------------------------------------------------

# Address that will own deployed contracts and receive initial token supply.
# Defaults to the deployer address if not set.
INITIAL_OWNER=0xYourWalletAddress

# Platform wallet that receives platform fees from deals.
PLATFORM_WALLET=0xYourPlatformWalletAddress

# Platform fee in basis points (100 = 1%, 500 = 5%).
PLATFORM_FEE_BPS=500

# ---------------------------------------------------------------------------
#  $BRXU Production Token Deployment (deploy-brxu.ts)
# ---------------------------------------------------------------------------

# Wallet addresses for token allocation (required for mainnet deploy)
TREASURY_WALLET=0xYourTreasuryWallet
REWARDS_WALLET=0xYourRewardsWallet
TEAM_VESTING_WALLET=0xYourTeamVestingWallet
LIQUIDITY_WALLET=0xYourLiquidityWallet
MARKETING_WALLET=0xYourMarketingWallet
PRESALE_WALLET=0xYourPresaleWallet

# ---------------------------------------------------------------------------
#  Uniswap v3 Liquidity Setup (setup-liquidity.ts)
# ---------------------------------------------------------------------------

# Initial liquidity amounts
INITIAL_BRXU_LIQUIDITY=50000000
INITIAL_USDC_LIQUIDITY=500000
BRXU_PRICE_USDC=0.01

# ---------------------------------------------------------------------------
#  Gas Reporting
# ---------------------------------------------------------------------------

# Set to "true" to enable gas reporting in tests
REPORT_GAS=false
