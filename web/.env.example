# =============================================================================
# BrixUp Web App — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# WARNING: Never commit your actual .env.local file to source control.
# =============================================================================

# ---------------------------------------------------------------------------
#  Supabase
# ---------------------------------------------------------------------------

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key — safe to expose client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase service role key — server-side only, NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
#  Coinbase Smart Wallet
# ---------------------------------------------------------------------------

# Coinbase Developer Platform app ID
NEXT_PUBLIC_COINBASE_APP_ID=your_app_id

# Target chain ID (8453 = Base Mainnet, 84532 = Base Sepolia)
NEXT_PUBLIC_CHAIN_ID=8453

# ---------------------------------------------------------------------------
#  Token Contract Addresses (Base)
# ---------------------------------------------------------------------------

# BrixToken ERC-20 contract address
NEXT_PUBLIC_BRXU_TOKEN_ADDRESS=0x...

# BrixFactory deal-creation factory contract address
NEXT_PUBLIC_BRXU_FACTORY_ADDRESS=0x...

# BrixStaking staking pool contract address
NEXT_PUBLIC_BRXU_STAKING_ADDRESS=0x...

# ---------------------------------------------------------------------------
#  KYC — Sumsub
# ---------------------------------------------------------------------------

# Sumsub app token (sandbox or production)
SUMSUB_APP_TOKEN=sbx:your_sumsub_app_token

# Sumsub secret key — server-side only
SUMSUB_SECRET_KEY=your_sumsub_secret_key

# ---------------------------------------------------------------------------
#  E-Signatures — BoldSign
# ---------------------------------------------------------------------------

# BoldSign API key — server-side only
BOLDSIGN_API_KEY=your_boldsign_api_key

# ---------------------------------------------------------------------------
#  Payments — Stripe
# ---------------------------------------------------------------------------

# Stripe publishable key (safe for frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe secret key — server-side only
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook signing secret — server-side only
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ---------------------------------------------------------------------------
#  Circle (USDC on-ramp)
# ---------------------------------------------------------------------------

# Circle API key for USDC payment processing
CIRCLE_API_KEY=your_circle_api_key

# ---------------------------------------------------------------------------
#  Application
# ---------------------------------------------------------------------------

# Public-facing app URL (used for OG images, callbacks, etc.)
NEXT_PUBLIC_APP_URL=https://brixups.com
