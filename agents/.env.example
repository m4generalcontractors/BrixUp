# =============================================================================
# M4 OPS Commander × ZeroClaw — Environment Variables
# =============================================================================
# Copy to .env and fill in production values

# ===== AI =====
ANTHROPIC_API_KEY=sk-ant-api03-...

# ===== DATABASE =====
DATABASE_URL=postgresql://m4admin:pass@localhost:5432/m4ops

# ===== SLACK (shared by all agents) =====
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=

# ===== WHATSAPP =====
WHATSAPP_ACCESS_TOKEN=EAABx...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_WEBHOOK_VERIFY_TOKEN=m4-wa-verify-...

# ===== TWILIO =====
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
TWILIO_WHATSAPP_NUMBER=+1...

# ===== EMAIL =====
RESEND_API_KEY=re_...
EMAIL_PASSWORD=

# ===== CRM =====
HUBSPOT_ACCESS_TOKEN=pat-...

# ===== ACCOUNTING =====
QUICKBOOKS_ACCESS_TOKEN=
QUICKBOOKS_COMPANY_ID=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# ===== PAYMENTS =====
STRIPE_SECRET_KEY=sk_live_...

# ===== GOOGLE =====
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== META =====
META_AD_ACCOUNT_ID=act_...
